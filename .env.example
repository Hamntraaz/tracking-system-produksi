# Lokal: frontend memanggil backend melalui Vite proxy.
VITE_API_BASE_URL=/api

# Deploy Vercel: ganti menjadi URL backend Railway.
VITE_API_BASE_URL=https://befriedchicken-production.up.railway.app/api

# Cloudinary unsigned upload preset untuk bukti foto pengiriman.
# Isi dengan akun Cloudinary milik project.
VITE_CLOUDINARY_CLOUD_NAME=dubjinrem
VITE_CLOUDINARY_UPLOAD_PRESET=buktiAntar
